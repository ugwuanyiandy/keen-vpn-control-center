generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum SubscriptionStatus {
  ACTIVE
  TRIAL
  EXPIRED
}

enum AuditAction {
  CREATED
  UPDATED
  ENABLED
  DISABLED
  DELETED
}

enum SubscriptionHistorySource {
  SELF_SERVICE
  SEED
  MIGRATION
}

model User {
  id             String          @id @default(cuid())
  fullName       String          @map("full_name")
  email          String          @unique
  passwordHash   String          @map("password_hash")
  role           UserRole        @default(CUSTOMER)
  pinnedServerId String?         @map("pinned_server_id")
  pinnedServer   Server?         @relation("PinnedServer", fields: [pinnedServerId], references: [id], onDelete: SetNull)
  subscription   Subscription?
  subscriptionHistory SubscriptionHistory[]
  sessions       Session[]
  auditLogs      AdminAuditLog[]
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  @@index([pinnedServerId])
  @@map("users")
}

model SubscriptionHistory {
  id             String                    @id @default(cuid())
  userId         String                    @map("user_id")
  user           User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan           String
  status         SubscriptionStatus
  previousPlan   String?                   @map("previous_plan")
  previousStatus SubscriptionStatus?       @map("previous_status")
  periodStart    DateTime                  @map("period_start")
  periodEnd      DateTime                  @map("period_end")
  source         SubscriptionHistorySource
  sourceKey      String?                   @unique @map("source_key")
  createdAt      DateTime                  @default(now()) @map("created_at")

  @@index([userId, createdAt(sort: Desc)])
  @@index([status])
  @@map("subscription_history")
}

model Subscription {
  id               String             @id @default(cuid())
  userId           String             @unique @map("user_id")
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan             String
  status           SubscriptionStatus
  currentPeriodEnd DateTime?          @map("current_period_end")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  @@index([status])
  @@map("subscriptions")
}

model Server {
  id        String          @id @default(cuid())
  country   String
  city      String
  hostname  String          @unique
  active    Boolean         @default(true)
  latencyMs Int             @map("latency_ms")
  pinnedBy  User[]          @relation("PinnedServer")
  auditLogs AdminAuditLog[]
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  @@index([active, country, city])
  @@index([country])
  @@index([city])
  @@map("servers")
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model AdminAuditLog {
  id          String      @id @default(cuid())
  actorUserId String      @map("actor_user_id")
  actor       User        @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  serverId    String?     @map("server_id")
  server      Server?     @relation(fields: [serverId], references: [id], onDelete: SetNull)
  action      AuditAction
  beforeState Json?       @map("before_state")
  afterState  Json?       @map("after_state")
  createdAt   DateTime    @default(now()) @map("created_at")

  @@index([actorUserId])
  @@index([serverId])
  @@index([createdAt(sort: Desc)])
  @@map("admin_audit_logs")
}
